---
import type { Newsletter } from '~/types';

import NewsletterSection from '~/components/tlo/NewsletterSection.astro';

import { toMarkdown } from '~/utils/tlo';

export interface Props {
  newsletter: Newsletter;
}

const { newsletter } = Astro.props;
---

<section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">

  <h1 class="text-4xl font-bold">The Lacking Details</h1>

  <div class="flex flex-row gap-2 my-6 justify-between border-y-2 border-double">
    <h4 class="text-sm font-bold">Issue {newsletter.issue}</h4>
    <h4 class="text-sm font-bold">You cannot alphabetize the unalphabeitable!</h4>
    <h4 class="text-sm font-bold">{newsletter.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</h4>
    <h4 class="text-sm font-bold">{newsletter.publishDate.toDateString()}</h4>
  </div>

  <div class="newsletter-text text-muted dark:text-slate-400 text-lg" set:html={toMarkdown(newsletter.newsletter.opening)} />

  <NewsletterSection title="Details" items={newsletter.newsletter.details} />

  <NewsletterSection title="Mixtapes" items={newsletter.newsletter.mixtapes} />

  <NewsletterSection title="Broadcasts" items={newsletter.newsletter.broadcasts} />

  <NewsletterSection title="Seen + Heard" items={newsletter.newsletter.videos} />

  <div class="newsletter-text text-muted dark:text-slate-400 text-lg" set:html={toMarkdown(newsletter.newsletter.closing)} />

  <hr class="mt-12" />
</section>
