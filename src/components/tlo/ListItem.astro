---
import Item from '~/components/blog/ListItem.astro';
import Video from '~/components/tlo/Video.astro';
import { findPostsBySlugs } from '~/utils/blog';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  slug?: string;
}

const { post, slug } = Astro.props;

if (!post && !slug) {
  throw new Error('Either post or slug must be provided');
}

var itemPost = post
if (!itemPost && slug) {
  itemPost = (await findPostsBySlugs([slug]))[0];
}

const isVideo = post?.category?.slug === 'videos';
---

{ isVideo ? (
  <Video post={itemPost} />
) : (
  <Item post={itemPost} />
)}
